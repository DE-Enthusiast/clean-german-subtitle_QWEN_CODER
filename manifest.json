{
  "manifest_version": 3,
  "name": "Clean German Subtitles for YouTube",
  "version": "4.4.0",
  "description": "Ultra-reliable German to English subtitle translation for YouTube using Gemini with keep-alive heartbeat, 3h+ continuous chunk support, and rate-limit resilience.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clean German Subtitles"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content_main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ]
}